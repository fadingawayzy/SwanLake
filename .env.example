# OpenRouter API key — get at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Model to use — MUST be a reasoning model for olympiad-level tasks
# Default: qwen/qwen3-235b-a22b (optimal cost/quality balance)
#
# Reasoning models (required for olympiad level, no hallucinations):
#   qwen/qwen3-next-80b-a3b-instruct — cheapest primary, $0.09/$1.10 per 1M
#   qwen/qwen3-235b-a22b           — main reasoning, $0.455/$1.82 per 1M
#   google/gemini-2.5-flash        — fast thinking, strong physics, $0.30/$2.50 per 1M
#
# DO NOT use non-reasoning models for olympiad tasks (hallucinate solutions):
#   deepseek/deepseek-chat, gemini-flash, haiku, etc.
# Snapshot prices as of 2026-04-28; actual at openrouter.ai/models
OPENROUTER_MODEL=qwen/qwen3-235b-a22b

# Cross-verification model — MUST differ from primary to catch hallucinations
# Independent-model agreement = strong correctness signal
# Recommended: use Gemini 2.5 Flash if primary is R1, and vice versa
OPENROUTER_VERIFIER_MODEL=google/gemini-2.5-flash
